{
  "app_name": "danta",
  "environment": "paper",
  "database_url": "sqlite+aiosqlite:///./data/danta-paper.db",
  "kis_credentials_path": ".secrets/kis/paper.json",
  "smtp_config_path": ".secrets/imported_financial_statement_analysis/email_config.json",
  "krx_credentials_path": ".secrets/imported_financial_statement_analysis/key.txt",
  "smtp_enabled": true,
  "log_level": "INFO",
  "buy_requires_user_approval": true,
  "unattended_auto_buy_enabled": false,
  "autonomous_initial_capital_krw": 50000000,
  "auto_stop_sell_enabled": true,
  "stop_loss_pct": "7.0",
  "stop_sell_requires_confirmation": false,
  "paper_order_execution_enabled": false,
  "real_order_execution_enabled": false,
  "maximum_managed_symbols": 3,
  "order_poll_interval_seconds": "2.0",
  "market_data_stale_seconds": 10,
  "fundamental_snapshot_path": "data/fundamentals/latest.json",
  "dart_corp_code_cache_path": "data/public-context/dart-corp-codes.json",
  "daily_run_root": "data/daily-runs",
  "dashboard_publish_repo": "../danta_report",
  "dashboard_public_url": "https://sungha-uu.github.io/danta_report/",
  "daily_publish_enabled": true,
  "daily_notify_enabled": true,
  "market_wide_monitor_enabled": true,
  "market_transition_email_enabled": false,
  "market_wide_poll_interval_seconds": 30,
  "market_pages_publish_enabled": true,
  "market_pages_publish_interval_seconds": 300,
  "market_pages_git_push_enabled": true,
  "market_dashboard_publish_repo": "../danta_market_status",
  "market_dashboard_public_url": "https://sungha-uu.github.io/danta_market_status/",
  "operations_dashboard_publish_repo": "../danta_operations",
  "operations_dashboard_public_url": "https://sungha-uu.github.io/danta_operations/",
  "performance_dashboard_publish_repo": "../danta_performance",
  "performance_dashboard_public_url": "https://sungha-uu.github.io/danta_performance/",
  "financial_analysis_dashboard_index_path": "../financial_statement_analysis_daily_report/index.html",
  "financial_analysis_dashboard_public_url": "https://sungha-uu.github.io/financial_statement_analysis_daily_report/",
  "public_dashboard_refresh_interval_seconds": 900,
  "market_entry_resume_required_path": "private/MARKET_ENTRY_RESUME_REQUIRED"
