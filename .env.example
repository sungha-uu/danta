# Optional public-data providers
DART_API_KEY=
KRX_DATA_ID=
KRX_DATA_PASSWORD=

# Active KIS provider uses JSON files under .secrets/kis/
DANTA_CONFIG=config/app.json
KIS_PAPER_CONFIG_PATH=.secrets/kis/paper.json
KIS_PROD_CONFIG_PATH=.secrets/kis/prod.json

# Optional alert channels
SMTP_CONFIG_PATH=.secrets/imported_financial_statement_analysis/email_config.json
SMTP_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# Application
APP_TIMEZONE=Asia/Seoul
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/kospi_box

# Trading invariants
TRADING_MODE=paper
BUY_REQUIRES_USER_APPROVAL=true
UNATTENDED_AUTO_BUY_ENABLED=false
APPROVED_BUY_EXECUTION_ENABLED=true
AUTO_STOP_SELL_ENABLED=true
STOP_LOSS_PCT=7.0
STOP_ORDER_TYPE=MARKET
STOP_SELL_REQUIRE_CONFIRMATION=false
